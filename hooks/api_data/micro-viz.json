{
  "micro_viz.guides_model_figure_1": {
    "name": "title",
    "anchor": "micro-viz-guides-model-figure-1",
    "signatures": [],
    "parameters": [
      {
        "name": "title",
        "types": [
          "str | None"
        ],
        "description": {
          "en": "A title. `None` draws none.",
          "zh-TW": "標題。`None` 不畫標題。",
          "zh-CN": "标题。`None` 不画标题。"
        },
        "default": "None"
      },
      {
        "name": "theme",
        "types": [
          "PlotTheme | None"
        ],
        "description": {
          "en": "The look of the figure. `None` uses the theme of the loaded settings ([Settings](settings.md#sec-settings)).",
          "zh-TW": "圖形的外觀。`None` 使用已載入設定的主題（參見 [設定](settings.md#sec-settings)）。",
          "zh-CN": "图形的外观。`None` 使用已加载设置的主题（参见 [设置](settings.md#sec-settings)）。"
        },
        "default": "None"
      },
      {
        "name": "labels",
        "types": [
          "Mapping[str, str] | None"
        ],
        "description": {
          "en": "Replacement text by label id ([Labels and placement](labels.md#sec-labels)).",
          "zh-TW": "依標籤編號取代的文字（參見 [標籤與位置](labels.md#sec-labels)）。",
          "zh-CN": "依标签编号取代的文本（参见 [标签与位置](labels.md#sec-labels)）。"
        },
        "default": "None"
      },
      {
        "name": "x_label",
        "types": [
          "str | None"
        ],
        "description": {
          "en": "The horizontal axis title; the default is set by the builder.",
          "zh-TW": "橫軸標題；預設由繪圖函式決定。",
          "zh-CN": "横轴标题；缺省由绘图函数决定。"
        },
        "default": "None"
      },
      {
        "name": "y_label",
        "types": [
          "str | None"
        ],
        "description": {
          "en": "The vertical axis title; the default is set by the builder.",
          "zh-TW": "縱軸標題；預設由繪圖函式決定。",
          "zh-CN": "纵轴标题；缺省由绘图函数决定。"
        },
        "default": "None"
      },
      {
        "name": "x_max",
        "types": [
          "float | None"
        ],
        "description": {
          "en": "The upper end of the horizontal axis; fix it, together with `y_range`, to keep the axes still in an animation ([Animation](animation.md#sec-animation)).",
          "zh-TW": "橫軸上界；與 `y_range` 一起固定，動畫中的座標軸才不會跳動（參見 [動畫](animation.md#sec-animation)）。",
          "zh-CN": "横轴上界；与 `y_range` 一起固定，动画中的坐标轴才不会跳动（参见 [动画](animation.md#sec-animation)）。"
        },
        "default": "None"
      },
      {
        "name": "y_range",
        "types": [
          "tuple[float, float] | None"
        ],
        "description": {
          "en": "The vertical range.",
          "zh-TW": "縱軸範圍。",
          "zh-CN": "纵轴范围。"
        },
        "default": "None"
      },
      {
        "name": "margin",
        "types": [
          "float"
        ],
        "description": {
          "en": "Extra room beyond the largest plotted value on each axis, as a fraction.",
          "zh-TW": "座標軸在資料最大值之外多留的比例。",
          "zh-CN": "坐标轴在数据最大值之外多留的比例。"
        },
        "default": "0.1"
      },
      {
        "name": "size",
        "types": [
          "tuple[float, float]"
        ],
        "description": {
          "en": "Figure size in inches.",
          "zh-TW": "圖形大小，單位為英寸。",
          "zh-CN": "图形大小，单位为英寸。"
        },
        "default": "(6.0, 6.0)"
      },
      {
        "name": "dpi",
        "types": [
          "int"
        ],
        "description": {
          "en": "Resolution of PNG output.",
          "zh-TW": "PNG 輸出的解析度。",
          "zh-CN": "PNG 输出的分辨率。"
        },
        "default": "150"
      }
    ]
  },
