  "micro_viz.guides_adding_figure_1": {
    "name": "Plane",
    "anchor": "micro-viz-guides-adding-figure-1",
    "signatures": [
      "Plane"
    ],
    "parameters": [
      {
        "name": "line(points, name=None, *, role=\"micro.curve.marginal\", at=1.0)",
        "types": [],
        "description": {
          "en": "A curve through `points`, named at the fraction `at` along it (1 is the right end).",
          "zh-TW": "經過 `points` 的曲線，名稱放在沿曲線 `at` 的比例處（1 是右端）。",
          "zh-CN": "经过 `points` 的曲线，名称放在沿曲线 `at` 的比例处（1 是右端）。"
        }
      },
      {
        "name": "thin(points, name=None, *, at=1.0)",
        "types": [],
        "description": {
          "en": "A curve after a change: thin and solid.",
          "zh-TW": "變動後的曲線：細實線。",
          "zh-CN": "变动后的曲线：细实线。"
        }
      },
      {
        "name": "guide(a, b)",
        "types": [],
        "description": {
          "en": "A dashed guide between two points.",
          "zh-TW": "兩點之間的虛線輔助線。",
          "zh-CN": "两点之间的虚线辅助线。"
        }
      },
      {
        "name": "dot(point)",
        "types": [],
        "description": {
          "en": "A dot.",
          "zh-TW": "一個點。",
          "zh-CN": "一个点。"
        }
      },
      {
        "name": "point(x, y, *, xtext=None, ytext=None, name=None, marker=True)",
        "types": [],
        "description": {
          "en": "A dot with dashed guides to the axes and the given axis marks.",
          "zh-TW": "一個點，附有通到座標軸的虛線輔助線與給定的軸上記號。",
          "zh-CN": "一个点，附有通到坐标轴的虚线辅助线与给定的轴上记号。"
        }
      },
      {
        "name": "xmark(x, text)",
        "types": [],
        "description": {
          "en": "A mark on the horizontal axis.",
          "zh-TW": "橫軸上的記號。",
          "zh-CN": "横轴上的记号。"
        }
      },
      {
        "name": "ymark(y, text)",
        "types": [],
        "description": {
          "en": "A mark on the vertical axis.",
          "zh-TW": "縱軸上的記號。",
          "zh-CN": "纵轴上的记号。"
        }
      },
      {
        "name": "area(polygon, name=None, *, shade=\"mid\")",
        "types": [],
        "description": {
          "en": "A shaded region, optionally named inside it.",
          "zh-TW": "上色的區域，可在區域內標示名稱。",
          "zh-CN": "上色的区域，可在区域内标示名称。"
        }
      },
      {
        "name": "arrow(a, b, *, rotate=False, label=None)",
        "types": [],
        "description": {
          "en": "A solid movement arrow: straight for a shift, curved with `rotate` for a slope change.",
          "zh-TW": "實線的移動箭頭：預設為直線表示平行移動，`rotate` 為彎箭頭表示斜率改變。",
          "zh-CN": "实线的移动箭头：缺省为直线表示平行移动，`rotate` 为弯箭头表示斜率改变。"
        }
      },
      {
        "name": "t(key, **fields)",
        "types": [],
        "description": {
          "en": "The built-in (or overridden) text for a label id.",
          "zh-TW": "標籤編號對應的內建（或已取代的）文字。",
          "zh-CN": "标签编号对应的内置（或已取代的）文本。"
        }
      },
      {
        "name": "finish()",
        "types": [],
        "description": {
          "en": "The finished `Canvas`.",
          "zh-TW": "完成的 `Canvas`。",
          "zh-CN": "完成的 `Canvas`。"
        }
      }
    ]
