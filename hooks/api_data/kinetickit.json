  "kinetickit.guides_typography_1": {
    "name": "GlyphKitTypography",
    "anchor": "kinetickit-guides-typography-1",
    "signatures": [
      "GlyphKitTypography(\n    engine,\n    *,\n    families,\n    size=14.0,\n    weight=400,\n    slant='normal',\n    max_width=None,\n    embed=True,\n    embedding_use=...,\n    allow_unknown=False,\n)"
    ],
    "parameters": [
      {
        "name": "engine",
        "types": [
          "TypographyEngine"
        ],
        "description": {
          "en": "The typography engine: a GlyphKit `FontLibrary`.",
          "zh-TW": "排版引擎：GlyphKit 的 `FontLibrary`。",
          "zh-CN": "排版引擎：GlyphKit 的 `FontLibrary`。"
        },
        "keyword_only": false
      },
      {
        "name": "families",
        "types": [
          "Sequence[str]"
        ],
        "description": {
          "en": "Font families in fallback order. Each must be in the library.",
          "zh-TW": "依後備順序排列的字族。每個都要在字型庫裡。",
          "zh-CN": "依后备顺序排列的字族。每个都要在字体库里。"
        },
        "keyword_only": true
      },
      {
        "name": "size",
        "types": [
          "float"
        ],
        "description": {
          "en": "Font size in the asset's own units; scale the `Text2D` to fit the scene.",
          "zh-TW": "字級，使用素材自己的單位；用 `Text2D` 的縮放配合場景。",
          "zh-CN": "字级，使用素材自己的单位；用 `Text2D` 的缩放配合场景。"
        },
        "keyword_only": true,
        "default": "14.0"
      },
      {
        "name": "weight",
        "types": [
          "int"
        ],
        "description": {
          "en": "Font weight from 100 to 900.",
          "zh-TW": "字重，從 100 到 900。",
          "zh-CN": "字重，从 100 到 900。"
        },
        "keyword_only": true,
        "default": "400"
      },
      {
        "name": "slant",
        "types": [
          "str"
        ],
        "description": {
          "en": "`\"normal\"`, `\"italic\"` or `\"oblique\"`.",
          "zh-TW": "`\"normal\"`、`\"italic\"` 或 `\"oblique\"`。",
          "zh-CN": "`\"normal\"`、`\"italic\"` 或 `\"oblique\"`。"
        },
        "keyword_only": true,
        "default": "\"normal\""
      },
      {
        "name": "max_width",
        "types": [
          "float | None"
        ],
        "description": {
          "en": "Wrap lines at this width. `None` keeps one line.",
          "zh-TW": "在此寬度換行。`None` 則只排成一行。",
          "zh-CN": "在此宽度换行。`None` 则只排成一行。"
        },
        "keyword_only": true,
        "default": "None"
      },
      {
        "name": "embed",
        "types": [
          "bool"
        ],
        "description": {
          "en": "Embed a permission-checked font subset in the asset.",
          "zh-TW": "把通過權限檢查的字型子集嵌入素材。",
          "zh-CN": "把通过权限检查的字体子集嵌入素材。"
        },
        "keyword_only": true,
        "default": "True"
      },
      {
        "name": "embedding_use",
        "types": [
          "EmbeddingUse"
        ],
        "description": {
          "en": "The declared use the permission check is made for.",
          "zh-TW": "權限檢查所對應的宣告用途。",
          "zh-CN": "权限检查所对应的声明用途。"
        },
        "keyword_only": true,
        "default": "EmbeddingUse.WEB"
      },
      {
        "name": "allow_unknown",
        "types": [
          "bool"
        ],
        "description": {
          "en": "Accept fonts whose embedding permission is unknown. The decision is recorded.",
          "zh-TW": "接受嵌入權限不明的字型，並記錄這個決定。",
          "zh-CN": "接受嵌入权限不明的字体，并记录这个决定。"
        },
        "keyword_only": true,
        "default": "False"
      }
    ]
  },
