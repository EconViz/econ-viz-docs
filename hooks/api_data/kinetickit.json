{
  "kinetickit.guides_accessibility_1": {
    "name": "Semantics",
    "anchor": "kinetickit-guides-accessibility-1",
    "signatures": [
      "Semantics(role=None, label=None, description=None, reading_order=None, hidden=False)"
    ],
    "parameters": [
      {
        "name": "role",
        "types": [
          "str | None"
        ],
        "description": {
          "en": "An ARIA-style role such as `\"graphics-symbol\"`.",
          "zh-TW": "ARIA 風格的角色，例如 `\"graphics-symbol\"`。",
          "zh-CN": "ARIA 风格的角色，例如 `\"graphics-symbol\"`。"
        },
        "keyword_only": false,
        "default": "None"
      },
      {
        "name": "label",
        "types": [
          "str | None"
        ],
        "description": {
          "en": "The short accessible name.",
          "zh-TW": "簡短的可存取名稱。",
          "zh-CN": "简短的可访问名称。"
        },
        "keyword_only": false,
        "default": "None"
      },
      {
        "name": "description",
        "types": [
          "str | None"
        ],
        "description": {
          "en": "A longer description.",
          "zh-TW": "較長的說明。",
          "zh-CN": "较长的说明。"
        },
        "keyword_only": false,
        "default": "None"
      },
      {
        "name": "reading_order",
        "types": [
          "int | None"
        ],
        "description": {
          "en": "Rank for linear reading; lower comes first, unranked objects follow in scene order.",
          "zh-TW": "線性閱讀時的順位，數字小的先讀；沒有順位的依場景順序接在後面。",
          "zh-CN": "线性阅读时的顺位，数字小的先读；没有顺位的依场景顺序接在后面。"
        },
        "keyword_only": false,
        "default": "None"
      },
      {
        "name": "hidden",
        "types": [
          "bool"
        ],
        "description": {
          "en": "Mark a purely decorative object.",
          "zh-TW": "標示純裝飾的物件。",
          "zh-CN": "标示纯装饰的对象。"
        },
        "keyword_only": false,
        "default": "False"
      }
    ]
  },
  "kinetickit.guides_accessibility_2": {
    "name": "AccessibilityInfo",
    "anchor": "kinetickit-guides-accessibility-2",
    "signatures": [
      "AccessibilityInfo(\n    title=None,\n    description=None,\n    alt_text=None,\n    long_description=None,\n    lang='en',\n    reduced_motion=...,\n)"
