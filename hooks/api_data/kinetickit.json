  "kinetickit.examples_adapt": {
    "name": "adapt",
    "anchor": "kinetickit-examples-adapt",
    "signatures": [
      "adapt(objects, adapter, *, overlay=(), camera=None, dimension=2) → SceneBase"
    ],
    "parameters": [
      {
        "name": "objects",
        "types": [
          "Iterable[T]"
        ],
        "description": {
          "en": "Your objects.",
          "zh-TW": "你的物件。",
          "zh-CN": "你的对象。"
        },
        "keyword_only": false
      },
      {
        "name": "adapter",
        "types": [
          "Callable[[T], Iterable[Node]]"
        ],
        "description": {
          "en": "Your depiction function. Every node needs a stable id.",
          "zh-TW": "你的描繪函式。每個節點都需要穩定的編號。",
          "zh-CN": "你的描绘函数。每个节点都需要稳定的编号。"
        },
        "keyword_only": false
      },
      {
        "name": "overlay",
        "types": [
          "Iterable[Node]"
        ],
        "description": {
          "en": "Extra nodes that stay in the scene.",
          "zh-TW": "留在場景中的額外節點。",
          "zh-CN": "留在场景中的额外节点。"
        },
        "keyword_only": true,
        "default": "()"
      },
      {
        "name": "camera",
        "types": [
          "Node | None"
        ],
        "description": {
          "en": "The camera, when the default is not wanted.",
          "zh-TW": "不想用預設相機時指定的相機。",
          "zh-CN": "不想用缺省相机时指定的相机。"
        },
        "keyword_only": true,
        "default": "None"
      },
      {
        "name": "dimension",
        "types": [
          "int"
        ],
        "description": {
          "en": "2 or 3.",
          "zh-TW": "2 或 3。",
          "zh-CN": "2 或 3。"
        },
        "keyword_only": true,
        "default": "2"
      }
    ]
  },
