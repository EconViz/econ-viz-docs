  "kinetickit.quickstart_3": {
    "name": "Point2D",
    "anchor": "kinetickit-quickstart-3",
    "signatures": [
      "Point2D(\n    *,\n    id,\n    opacity=1.0,\n    z=0.0,\n    visible=True,\n    semantics=None,\n    position=Vec2(x=0.0, y=0.0),\n    size=4.0,\n    symbol='circle',\n    color=...,\n    stroke=None,\n    stroke_width=1.0,\n)"
    ],
    "parameters": [
      {
        "name": "id",
        "types": [
          "str"
        ],
        "description": {
          "en": "The stable id. Motions, interactions and scene transitions find the node by it.",
          "zh-TW": "穩定的編號。動作、互動與場景轉場都靠它找到節點。",
          "zh-CN": "稳定的编号。动作、交互与场景转场都靠它找到节点。"
        },
        "keyword_only": true
      },
      {
        "name": "position",
        "types": [
          "Vec2"
        ],
        "description": {
          "en": "Where the point sits, in world coordinates.",
          "zh-TW": "點的位置，使用世界座標。",
          "zh-CN": "点的位置，使用世界坐标。"
        },
        "keyword_only": true,
        "default": "Vec2(x=0.0, y=0.0)"
      },
      {
        "name": "size",
        "types": [
          "float"
        ],
        "description": {
          "en": "The marker size in output units.",
          "zh-TW": "標記大小，單位同輸出。",
          "zh-CN": "标记大小，单位同输出。"
        },
        "keyword_only": true,
        "default": "4.0"
      },
      {
        "name": "color",
        "types": [
          "Color | str"
        ],
        "description": {
          "en": "Fill colour: a `Color` or a CSS-style string such as `\"#e4572e\"`.",
          "zh-TW": "填色：`Color`，或像 `\"#e4572e\"` 這樣的字串。",
          "zh-CN": "填色：`Color`，或像 `\"#e4572e\"` 这样的字符串。"
        },
        "keyword_only": true,
        "default": "..."
      },
      {
        "name": "opacity",
        "types": [
          "float"
        ],
        "description": {
          "en": "From 0 (hidden) to 1 (opaque).",
          "zh-TW": "從 0（隱藏）到 1（不透明）。",
          "zh-CN": "从 0（隐藏）到 1（不透明）。"
        },
        "keyword_only": true,
        "default": "1.0"
      },
      {
        "name": "semantics",
        "types": [
          "Semantics | None"
        ],
        "description": {
          "en": "Role, label and reading order for assistive technology.",
          "zh-TW": "給輔助科技使用的角色、標籤與閱讀順序。",
          "zh-CN": "给辅助科技使用的角色、标签与阅读顺序。"
        },
        "keyword_only": true,
        "default": "None"
      }
    ]
  },
