  "kinetickit.quickstart_1": {
    "name": "Animation",
    "anchor": "kinetickit-quickstart-1",
    "signatures": [
      "Animation(scene, motion=None, *, registry=..., interactions=None, accessibility=None)"
    ],
    "parameters": [
      {
        "name": "scene",
        "types": [
          "SceneBase"
        ],
        "description": {
          "en": "The scene: nodes, overlay and camera. 2D and 3D scenes are both accepted.",
          "zh-TW": "場景：節點、疊層與相機。2D 與 3D 場景都可以。",
          "zh-CN": "场景：节点、叠层与相机。2D 与 3D 场景都可以。"
        },
        "keyword_only": false
      },
      {
        "name": "motion",
        "types": [
          "Motion | None"
        ],
        "description": {
          "en": "The motion tree. `None` gives a still animation.",
          "zh-TW": "動作樹。`None` 表示靜止的動畫。",
          "zh-CN": "动作树。`None` 表示静止的动画。"
        },
        "keyword_only": false,
        "default": "None"
      },
      {
        "name": "interactions",
        "types": [
          "InteractionSpec | None"
        ],
        "description": {
          "en": "Declarative interactions bound to node ids ([Typography and accessibility](guides/accessibility.md#sec-interaction)).",
          "zh-TW": "綁定到節點編號的宣告式互動（參見[文字與無障礙](guides/accessibility.md#sec-interaction)）。",
          "zh-CN": "绑定到节点编号的声明式交互（参见[文本与无障碍](guides/accessibility.md#sec-interaction)）。"
        },
        "keyword_only": true,
        "default": "None"
      },
      {
        "name": "accessibility",
        "types": [
          "AccessibilityInfo | None"
        ],
        "description": {
          "en": "Title, descriptions, language and the reduced-motion policy.",
          "zh-TW": "標題、說明文字、語言與減少動態的處理方式。",
          "zh-CN": "标题、说明文本、语言与减少动态的处理方式。"
        },
        "keyword_only": true,
        "default": "None"
      }
    ]
  },
  "kinetickit.quickstart_save": {
    "name": "Animation.save",
    "anchor": "kinetickit-quickstart-save",
    "signatures": [
      "Animation.save(target, *, renderer=None, **options) → Any"
    ],
    "parameters": [
      {
        "name": "target",
        "types": [
          "str | PathLike | Destination"
        ],
        "description": {
          "en": "A file path, a stream or another destination. The suffix of a path picks the format: `.svg`, `.gif` or `.html`.",
          "zh-TW": "檔案路徑、串流或其他輸出目標。路徑的副檔名決定格式：`.svg`、`.gif` 或 `.html`。",
          "zh-CN": "文件路径、串流或其他输出目标。路径的扩展名决定格式：`.svg`、`.gif` 或 `.html`。"
        },
        "keyword_only": false
      },
      {
        "name": "renderer",
        "types": [
          "str | None"
        ],
        "description": {
          "en": "Force a renderer: `vector`, `raster` or `interactive`. `None` follows the format.",
          "zh-TW": "指定繪圖端：`vector`、`raster` 或 `interactive`。`None` 則依格式決定。",
          "zh-CN": "指定绘图端：`vector`、`raster` 或 `interactive`。`None` 则依格式决定。"
        },
        "keyword_only": true,
        "default": "None"
      },
      {
        "name": "**options",
        "types": [
          "Any"
        ],
        "description": {
          "en": "Options of the chosen output, such as `width`, `height`, `fps` or `title` ([Output formats](guides/outputs.md#sec-options)).",
          "zh-TW": "所選輸出的選項，例如 `width`、`height`、`fps` 或 `title`（參見[輸出格式](guides/outputs.md#sec-options)）。",
          "zh-CN": "所选输出的选项，例如 `width`、`height`、`fps` 或 `title`（参见[输出格式](guides/outputs.md#sec-options)）。"
        },
        "keyword_only": false
      }
    ]
  },
