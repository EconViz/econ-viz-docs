      {
        "name": "description",
        "types": [
          "str | None"
        ],
        "description": {
          "en": "A short description.",
          "zh-TW": "簡短說明。",
          "zh-CN": "简短说明。"
        },
        "keyword_only": false,
        "default": "None"
      },
      {
        "name": "alt_text",
        "types": [
          "str | None"
        ],
        "description": {
          "en": "The short alternative for GIF and images.",
          "zh-TW": "GIF 與圖片使用的簡短替代文字。",
          "zh-CN": "GIF 与图片使用的简短替代文本。"
        },
        "keyword_only": false,
        "default": "None"
      },
      {
        "name": "long_description",
        "types": [
          "str | None"
        ],
        "description": {
          "en": "The full text alternative.",
          "zh-TW": "完整的文字替代內容。",
          "zh-CN": "完整的文本替代内容。"
        },
        "keyword_only": false,
        "default": "None"
      },
      {
        "name": "lang",
        "types": [
          "str"
        ],
        "description": {
          "en": "Language tag of the texts.",
          "zh-TW": "文字的語言標籤。",
          "zh-CN": "文本的语言标签。"
        },
        "keyword_only": false,
        "default": "\"en\""
      },
      {
        "name": "reduced_motion",
        "types": [
          "ReducedMotion"
        ],
        "description": {
          "en": "What to show when the viewer asks for reduced motion.",
          "zh-TW": "觀看者要求減少動態時要顯示的內容。",
          "zh-CN": "观看者要求减少动态时要显示的内容。"
        },
        "keyword_only": false,
        "default": "..."
      }
    ]
